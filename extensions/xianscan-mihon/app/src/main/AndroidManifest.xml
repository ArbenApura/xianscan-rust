<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- REQUIRED BY MIHON / TACHIYOMI FOR EXTENSION DISCOVERY -->
    <uses-feature android:name="tachiyomi.extension" />

    <application
        android:label="${appName}"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- SOURCE CLASS / FACTORY ENTRYPOINT METADATA -->
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value="${extClass}" />
        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="${nsfw}" />
        <!-- EXTENSION LIB VERSION, READ BEFORE THE versionName FALLBACK (FEAT-005 PHASE 6, ADR-005) -->
        <meta-data
            android:name="tachiyomix.extensionLib"
            android:value="${extensionLib}" />
    </application>

</manifest>
