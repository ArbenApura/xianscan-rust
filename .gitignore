# ==============================================================================
# RUST & CARGO BUILD ARTIFACTS
# ==============================================================================
/target/
**/*.rs.bk
*.pdb
*.tar.gz


# ==============================================================================
# WEB / NODE.JS / SVELTEKIT ARTIFACTS
# ==============================================================================
web/node_modules/
web/build/
web/bin/
web/.svelte-kit/
web/package/
web/coverage/
web/vite.config.ts.timestamp-*
docs-site/node_modules/
docs-site/build/
docs-site/.svelte-kit/
docs-site/package/
docs-site/coverage/
docs-site/vite.config.ts.timestamp-*
docs-site/vite.config.js.timestamp-*
extensions/**/node_modules/
extensions/**/dist/
extensions/**/dist-firefox/
extensions/**/store/
extensions/**/.gradle/
extensions/**/build/
extensions/**/local.properties
extensions/**/signing.properties
*.jks
*.keystore
.gradle/
local.properties

# Web Environment Files
web/.env
web/.env.*
!web/.env.example

# ==============================================================================
# RUNTIME USER DATA & DATABASE (PRESERVE DIRECTORY STRUCTURE)
# ==============================================================================
web/data/*.db
web/data/*.db-shm
web/data/*.db-wal
web/data/uploads/*
web/data/output/*
web/data/clean/*
web/data/cache/*
!web/data/**/.gitkeep

# ==============================================================================
# LARGE AI MODEL WEIGHTS (>100MB BLOCKED BY GITHUB WITHOUT GIT LFS)
# ==============================================================================
models/*.onnx
models/*.pt
models/*.pth
models/*.bin
!models/.gitkeep
!models/ppocr_keys_v1.txt
!models/rapidocr_keys.json

# ==============================================================================
# LOGS, TEMPORARY & OS FILES
# ==============================================================================
# OPS NOTES WITH LIVE INFRASTRUCTURE CREDENTIALS — NEVER COMMIT
FINDINGS.md
*.log
*.log.*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
staging/
tests/.cache/
.agents/
.reasonix/
.discord/
grounding-lab/
training-lab/
docs/superpowers/
superpowers/


# ==============================================================================
# PRIVATE TEST FIXTURES & LOCAL MANGA BENCHMARK DATASETS
# ==============================================================================
tests/fixtures/private/
tests/fixtures/downloads/
tests/fixtures/**/*.raw.*
tests/fixtures/**/*.webp
tests/fixtures/**/*.jpg
tests/fixtures/**/*.png
!tests/fixtures/**/.gitkeep
!tests/fixtures/synthetic/**
