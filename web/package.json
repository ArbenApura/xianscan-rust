{
	"name": "xianscan-web",
	"version": "0.4.0-beta.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 8125",
		"build": "vite build",
		"preview": "node --env-file-if-exists=.env build --host 0.0.0.0 --port 8124",
		"start": "node --env-file-if-exists=.env build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env src/lib/server/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"test:coverage": "svelte-kit sync && vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^9.14.0",
		"@fontsource/lexend": "^5.3.0",
		"@fontsource/montserrat": "^5.3.0",
		"@fontsource/nunito-sans": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^4",
		"@types/better-sqlite3": "^7.6.12",
		"@types/papaparse": "^5.3.15",
		"@vitest/coverage-v8": "^4.1.10",
		"autoprefixer": "^10.4.20",
		"drizzle-kit": "^0.28.1",
		"eslint": "^9.14.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^15.12.0",
		"jsdom": "^30.0.1",
		"postcss": "^8.4.49",
		"prettier": "3.3.3",
		"prettier-plugin-svelte": "3.2.6",
		"prettier-plugin-tailwindcss": "0.6.5",
		"svelte": "^4.2.19",
		"svelte-check": "^4.0.9",
		"tailwindcss": "^3.4.15",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.14.0",
		"vite": "^5.4.11",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/inter": "^5.1.0",
		"@fontsource/lora": "^5.1.0",
		"@napi-rs/canvas": "^1.0.5",
		"@napi-rs/image": "^1.14.0",
		"ahocorasick": "^1.0.2",
		"better-sqlite3": "^11.10.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.36.1",
		"fflate": "^0.8.2",
		"lucide-svelte": "0.460.0",
		"openai": "^4.71.1",
		"p-queue": "^8.0.1",
		"papaparse": "^5.4.1",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^2.5.4",
		"zod": "^3.23.8"
	}
}
