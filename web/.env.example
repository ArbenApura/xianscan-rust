# ML SIDECAR (FASTAPI — DETECT/OCR/INPAINT). START IT WITH: cd ml && uvicorn app.main:app --port 8123
ML_BASE_URL=http://127.0.0.1:8123

# WEB SERVER PORT & HOST FOR PRODUCTION / PREVIEW
PORT=8124
HOST=0.0.0.0

# SQLITE DATABASE PATH (RELATIVE TO THE web/ DIRECTORY; :memory: FOR TESTS)
DATABASE_PATH=./data/manua.db

# APP DATA ROOT — UPLOADS / CLEANED / OUTPUT IMAGES (DEFAULT: ./data RELATIVE TO THE PROCESS CWD)
# DATA_ROOT=./data

# UPLOADS: adapter-node's DEFAULT BODY_SIZE_LIMIT IS 512K — RAISE IT ABOVE THE LARGEST UPLOAD LIMIT
# (REQUIRED FOR `npm run start` / `npm run preview`; vite dev HAS NO LIMIT).
BODY_SIZE_LIMIT=64M

# NOTE: AI Translation Providers (DeepSeek, Google AI Studio, etc.) are configured directly
# in the Web UI (Settings -> AI & Providers) and stored securely in SQLite. No API key env vars required.
