# ML SIDECAR (AXUM / RUST ORT). START IT WITH: cargo run -- --ml-only
ML_BASE_URL=http://127.0.0.1:8123

# WEB SERVER PORT & HOST
PORT=8124
DEV_PORT=8125
HOST=0.0.0.0

# UPLOADS: adapter-node's DEFAULT BODY_SIZE_LIMIT IS 512K — RAISE IT ABOVE THE LARGEST UPLOAD LIMIT
BODY_SIZE_LIMIT=64M

# NOTE: SQLite database and uploaded data automatically resolve to the OS AppData directory:
#   Windows: %APPDATA%/XianScan/data/xianscan.db
#   macOS:   ~/Library/Application Support/XianScan/data/xianscan.db
#   Linux:   ~/.local/share/xianscan/data/xianscan.db
# (Set DATABASE_PATH and DATA_ROOT only if you want to override this default).
# DATABASE_PATH=
# DATA_ROOT=

# NOTE: AI Translation Providers (DeepSeek, Google AI Studio, etc.) are configured directly
# in the Web UI (Settings -> AI & Providers) and stored securely in SQLite. No API key env vars required.
